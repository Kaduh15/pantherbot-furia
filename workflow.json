              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "0ba5a97a-2bb2-4556-9e23-4aaffe669c69",
                    "leftValue": "^(1|2|3)$",
                    "rightValue": "={{ $('Telegram Trigger').item.json.message.text }}",
                    "operator": {
                      "type": "string",
                      "operation": "notRegex"
                    }
                  }
                ],
                "combinator": "and"
