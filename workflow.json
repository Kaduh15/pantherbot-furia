        "jsCode": "const perguntasRespondidas = $('Banco - Buscar usuario').first().json.questions_answered\nconst perguntas = $input.all()\n\nconst perguntasNaoRespondidas = perguntas.filter(({json}) => {\n  return !perguntasRespondidas.includes(json.id)\n})\n\nconst perguntaEscolhida = perguntasNaoRespondidas[Math.floor(Math.random() * perguntasNaoRespondidas.length)]\n\nreturn perguntaEscolhida;"
