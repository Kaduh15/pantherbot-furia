      "parameters": {
        "jsCode": "const usuario = $('Banco - Buscar usuario').first().json\n\nconst idsRespondidas = usuario?.questions_answered || []\n\nconst idsFormatados = idsRespondidas.map(id => `\"${id}\"`).join(',')\n\nconst filtro = `id=not.in.(${idsFormatados})`\n\nreturn [{\n  json: {\n    filtro\n  }\n}]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        600
      ],
      "id": "503d187c-46fb-47e0-a4aa-51ee520e7f00",
      "name": "Filtro - Perguntas não respondidas"
    },
